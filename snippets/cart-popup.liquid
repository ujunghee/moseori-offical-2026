          return;
        }
        
        // 재고 수량 확인 (여러 필드 체크)
        let availableQuantity = variant.inventory_quantity;
        
        // 다른 필드도 확인
        if (typeof availableQuantity !== 'number') {
          availableQuantity = variant.available || variant.stock || variant.quantity || 0;
        }
        
        console.log('사용 가능 재고:', availableQuantity, '요청 수량:', newQuantity);
        
        if (newQuantity > availableQuantity && availableQuantity !== null) {
          alert(`재고가 부족합니다. 최대 구매 가능 수량: ${availableQuantity}개`);
