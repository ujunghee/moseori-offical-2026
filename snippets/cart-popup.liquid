<style>
  .cart-popup {
    position: fixed;
    min-width: 38rem;
    width: 32vw;
    max-width: 40rem;
    height: 100%;
    right: -40rem;
    z-index: 1000;
    visibility: hidden;
    transition: .6s cubic-bezier(0.41, 0.01, 0.25, 1);
  }
  
  .cart-popup.active {
    position: fixed;
    visibility: visible;
    right: 0;
  }
  .cart-popup-content {
    background-color: #fffefd;
    padding: 20px;
    overflow-y: auto;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    box-shadow: 0 0 6px #2f2c2c0f;
  }
  .cart-popup-header {
    display:flex;
    justify-content: space-between;
    align-items: center;
  }
  .cart-popup-title {
    font-size:1.6rem;
    font-weight:600;
    margin:0;
  }
  .cart-popup-close {
    font-size: 24px;
    width: 2.4rem;
    height: 2.4rem;
    background: inherit;
    border: none;
    position: relative;
    cursor: pointer;
  }
  .cart-popup-close:before {
    content: "";
    width: 1.2rem;
    display: block;
    height: .1rem;
    background: #000000;
    transform: rotate(-45deg);
    top: 50%;
    position: absolute;
  }
  .cart-popup-close:after {
    content: "";
    width: 1.2rem;
    display: block;
    height: .1rem;
    background: #000000;
    transform: rotate(45deg);
    top: 50%;
    position: absolute;
  }
  .cart-popup-item {
    display: flex;
    margin-bottom: 15px;
    padding-bottom: 15px;
    position: relative;
  }

  .cart-popup-item-image {
    width: 80px;
    margin-right: 15px;
  }

  .cart-popup-item-image img {
    width: 100%;
    height: auto;
  }

  .cart-popup-item-details {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .cart-popup-item-quantity {
    color: #000;
    font-size:14px;
  }
  .cart-popup-item-title {
    color: #000;
    font-weight: 500;
    margin-bottom: 4px;
    width:180px;
  }
  
  /* 새로 추가된 variant 정보 스타일 */
  .cart-popup-item-variant {
    color: #666;
    font-size: 12px;
    margin-bottom: 8px;
    line-height: 1.3;
  }
  
  .cart-popup-item-variant-option {
    display: inline-block;
    margin-right: 8px;
  }
  
  .cart-popup-item-price {
    color: #000;
    font-size:14px;
  }
  .cart-popup-item-remove {
    position: absolute;
    right: 0;
    top: 0;
    background: none;
    border: none;
    color: #8c8c8c;
    cursor: pointer;
    font-size: 14px;
    padding: 5px;
    transition: .3s;
    font-family: Times New Roman, Times, serif;
  }
  .cart-popup-item-remove:hover {
    color: #000;
  }
  .cart-popup-empty {
    padding: 20px 0;
    text-align: center;
    color: #8c8c8c;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .cart-popup-footer {
    padding-top: 20px;
  }

  .cart-popup-subtotal {
    display: flex;
    justify-content: space-between;
    font-weight: bold;
    margin-bottom: 15px;
  }
  .cart-popup-items {
    flex: 1;
    overflow: auto;
  }
  .cart-popup-subtotal span {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    color: #000;
    letter-spacing: -.02rem;
  }
  .cart-popup-subtotal .cart-popup-total {
    font-weight: 500;
    letter-spacing: 0;
  }
  .cart-popup-buttons {
    display: flex;
    justify-content: space-between;
    flex-direction: column;
    gap: .8rem;
  }

  .btn-checkout, .btn-view-cart {
    padding: 8px 15px;
    text-align: center;
    width: 100%;
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    text-transform: uppercase;
    display: inline-block;
  }

  .btn-checkout {
    background-color: #000;
    color: white;
    flex-grow: 1;
    margin-right: 10px;
  }

  .btn-view-cart {
    border: 1px solid #000;
    color: #000;
  }

  .loading-spinner {
    display: none;
    width: 20px;
    height: 20px;
    border: 2px solid rgba(0, 0, 0, 0.1);
    border-top: 2px solid #000;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto;
  }

  .item-removing .loading-spinner {
    display: inline-block;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* 수량 조절 관련 스타일 */
.cart-popup-item-quantity-control {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cart-popup-item-quantity-minus,
.cart-popup-item-quantity-plus {
    width: 24px;
    height: 24px;
    border: none;
    background: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    color:black;
    line-height: 1;
    transition: all 0.2s;
}

.cart-popup-item-quantity-minus:hover,
.cart-popup-item-quantity-plus:hover {
  background-color: #e9e9e9;
}

.cart-popup-item-quantity {
  font-size: 14px;
  min-width: 20px;
  text-align: center;
}

.item-updating {
  opacity: 0.7;
  pointer-events: none;
}
@media screen and (max-width: 749px) {
  .cart-popup-item-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    width: 9rem;
  }
    .cart-popup {
    min-width: 30rem;
  }
}
</style>
