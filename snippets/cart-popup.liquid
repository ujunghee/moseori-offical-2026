{%- comment -%}
<script>
  // 장바구니 팝업 열기 함수
  function openCartPopup() {
    // 장바구니 정보 가져오기
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        // 장바구니 팝업 요소 가져오기
        const cartPopup = document.getElementById('cart-popup');
        if (cartPopup) {
          // 장바구니 내용 업데이트
          updateCartPopupContents(cart);
          // 팝업 표시
          cartPopup.classList.add('active');
        }
      })
      .catch(error => {
        console.error('장바구니 정보 가져오기 오류:', error);
      });
    
    return false;
  }
  
  // variant 옵션 텍스트 생성 함수
  function formatVariantOptions(item) {
    let variantText = '';
    
    // variant_title이 있고 'Default Title'이 아닌 경우
    if (item.variant_title && item.variant_title !== 'Default Title') {
      variantText = item.variant_title;
    } 
    // options 배열이 있는 경우
    else if (item.options && Array.isArray(item.options)) {
      const validOptions = item.options.filter(option => 
        option && 
        option !== 'Default Title' && 
        option.trim() !== ''
      );
      
      if (validOptions.length > 0) {
        variantText = validOptions.join(' / ');
      }
    }
    // option1, option2, option3 개별 필드가 있는 경우
    else {
      const options = [];
      if (item.option1 && item.option1 !== 'Default Title') options.push(item.option1);
      if (item.option2 && item.option2 !== 'Default Title') options.push(item.option2);
      if (item.option3 && item.option3 !== 'Default Title') options.push(item.option3);
      
      if (options.length > 0) {
        variantText = options.join(' / ');
      }
    }
    
    return variantText;
  }
  
  // 장바구니 팝업 내용 업데이트 함수 수정 (variant 정보 추가)
  window.updateCartPopupContents = function(cart) {
    console.log('Updating cart popup with:', cart); // 디버깅용
    
    // 헤더의 장바구니 카운트 업데이트
    const cartCountElements = document.querySelectorAll('.cart-count');
    cartCountElements.forEach(element => {
      if (element) {
        element.textContent = cart.item_count || 0;
      }
    });
    
    const cartPopup = document.getElementById('cart-popup');
    if (!cartPopup) {
      console.error('Cart popup element not found!');
      return;
    }
    
    const cartItems = cartPopup.querySelector('.cart-popup-items');
    const cartTotal = cartPopup.querySelector('.cart-popup-total');
    
    if (!cartItems || !cartTotal) {
      console.error('Cart popup items or total element not found!');
      return;
    }
    
    // 장바구니 아이템 렌더링 - variant 정보 추가
    let itemsHTML = '';
    
    // cart 객체 구조 확인
    if (cart.items && Array.isArray(cart.items) && cart.items.length > 0) {
      cart.items.forEach((item, index) => {
        // 이미지 URL 확인 및 처리
        const imageUrl = item.image 
          ? (typeof item.image === 'string' ? item.image : item.image.src || '')
          : '';
        
        const itemId = item.key || item.id || index + 1;
        
        // variant 옵션 텍스트 생성
        const variantText = formatVariantOptions(item);
        const variantHTML = variantText ? `<div class="cart-popup-item-variant">${variantText}</div>` : '';
        
        itemsHTML += `
          <div class="cart-popup-item" data-item-id="${itemId}" data-item-index="${index + 1}">
            <div class="cart-popup-item-image">
              <img src="${imageUrl.replace(/(\.[^.]*)$/, '_120x$1')}" alt="${item.product_title || item.title}" />
            </div>
            <div class="cart-popup-item-details">
              <div class="i-top">
                <div class="cart-popup-item-title">${item.product_title || item.title}</div>
                ${variantHTML}
                <div class="cart-popup-item-quantity-control">
                  <button class="cart-popup-item-quantity-minus" data-item-index="${index + 1}">-</button>
                  <span class="cart-popup-item-quantity">${item.quantity}</span>
                  <button class="cart-popup-item-quantity-plus" data-item-index="${index + 1}">+</button>
                </div>
              </div>
              <div class="cart-popup-item-price">${window.formatMoney ? window.formatMoney(item.final_price || item.price) : formatMoney(item.final_price || item.price)}</div>
            </div>
            <button class="cart-popup-item-remove" data-item-index="${index + 1}">remove</button>
            <div class="loading-spinner"></div>
          </div>
        `;
      });
    } else {
      // 장바구니가 비어있는 경우
      itemsHTML = '<div class="cart-popup-empty">empty</div>';
    }
    
    cartItems.innerHTML = itemsHTML;
    
    // 합계 업데이트
    if (cart.total_price !== undefined) {
      cartTotal.textContent = window.formatMoney ? window.formatMoney(cart.total_price) : formatMoney(cart.total_price);
    } else {
      console.error('Total price not found in cart object:', cart);
    }
    
    // 삭제 버튼에 이벤트 리스너 추가
    const removeButtons = cartItems.querySelectorAll('.cart-popup-item-remove');
    removeButtons.forEach(button => {
      button.addEventListener('click', window.handleRemoveItem);
    });
    
    // 수량 감소 버튼에 이벤트 리스너 추가
    const minusButtons = cartItems.querySelectorAll('.cart-popup-item-quantity-minus');
    minusButtons.forEach(button => {
      button.addEventListener('click', window.handleQuantityChange.bind(null, 'decrease'));
    });
    
    // 수량 증가 버튼에 이벤트 리스너 추가
    const plusButtons = cartItems.querySelectorAll('.cart-popup-item-quantity-plus');
    plusButtons.forEach(button => {
      button.addEventListener('click', window.handleQuantityChange.bind(null, 'increase'));
    });
  };

// 수량 변경 처리 함수 (이중 재고 체크)
window.handleQuantityChange = function(action, event) {
  event.preventDefault();
  
  const button = event.currentTarget;
  const itemIndex = button.dataset.itemIndex;
  const itemContainer = button.closest('.cart-popup-item');
  
  if (!itemIndex || !itemContainer) return;
  
  // 현재 수량 확인
  const quantityElement = itemContainer.querySelector('.cart-popup-item-quantity');
  let currentQuantity = parseInt(quantityElement.textContent);
  
  // 새로운 수량 계산
  let newQuantity = currentQuantity;
  
  if (action === 'increase') {
    newQuantity = currentQuantity + 1;
    
    // 1차: 빠른 재고 체크
    quickInventoryCheck(itemIndex, newQuantity, itemContainer, button);
    return;
    
  } else if (action === 'decrease') {
    newQuantity = currentQuantity - 1;
    
    // 수량이 0이 되면 삭제 처리
    if (newQuantity <= 0) {
      window.handleRemoveItem({
        preventDefault: () => {},
        currentTarget: itemContainer.querySelector('.cart-popup-item-remove')
      });
      return;
    }
    
    // 감소는 바로 처리 (재고 체크 불필요)
    updateCartQuantityWithFallback(itemIndex, newQuantity, itemContainer, button);
  }
};

// 1차: 빠른 재고 체크
function quickInventoryCheck(itemIndex, newQuantity, itemContainer, button) {
  // 버튼 일시 비활성화 (중복 클릭 방지)
  button.disabled = true;
  
  // 현재 장바구니 정보 가져오기
  fetch('/cart.js')
    .then(response => response.json())
    .then(cart => {
      const item = cart.items[itemIndex - 1];
      
      if (!item) {
        throw new Error('아이템을 찾을 수 없습니다.');
      }
      
      // variant 재고 정보 확인
      return fetch(`/variants/${item.variant_id}.js`);
    })
    .then(response => response.json())
    .then(variant => {
      button.disabled = false;
      
      // 재고 관리하지 않는 경우 바로 진행
      if (variant.inventory_management !== 'shopify') {
        updateCartQuantityWithFallback(itemIndex, newQuantity, itemContainer, button);
        return;
      }
      
      // 재고 정책이 continue인 경우 바로 진행
      if (variant.inventory_policy === 'continue') {
        updateCartQuantityWithFallback(itemIndex, newQuantity, itemContainer, button);
        return;
      }
      
      // 재고 수량 확인
      const availableQuantity = variant.inventory_quantity || 0;
      
      if (newQuantity > availableQuantity) {
        // 1차 체크에서 재고 부족 감지
        alert(`재고가 부족합니다. 최대 구매 가능 수량: ${availableQuantity}개`);
      } else {
        // 1차 체크 통과 - 2차 서버 검증으로 진행
        updateCartQuantityWithFallback(itemIndex, newQuantity, itemContainer, button);
      }
    })
    .catch(error => {
      console.error('1차 재고 확인 중 오류:', error);
      button.disabled = false;
      
      // 1차 체크 실패 시에도 2차 체크로 진행 (서버가 최종 판단)
      updateCartQuantityWithFallback(itemIndex, newQuantity, itemContainer, button);
    });
}

// 2차: 서버 검증 + 폴백 처리 (간소화)
function updateCartQuantityWithFallback(itemIndex, newQuantity, itemContainer, button) {
  // UI 상태 표시
  itemContainer.classList.add('item-updating');
  button.disabled = true;
  
  const originalQuantity = parseInt(itemContainer.querySelector('.cart-popup-item-quantity').textContent);
  
  const body = JSON.stringify({
    line: parseInt(itemIndex),
    quantity: newQuantity
  });
  
  fetch('/cart/change.js', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json'
    },
    body: body
  })
  .then(response => {
    if (response.ok) {
      // 성공한 경우에만 JSON 파싱
      return response.json().then(cart => {
        if (cart && cart.items && typeof cart.total_price !== 'undefined') {
          // 정상적인 cart 객체
          window.updateCartPopupContents(cart);
        } else {
          throw new Error('잘못된 응답 형식');
        }
      });
    } else {
      // 422 등 에러 응답
      return response.json().then(errorData => {
        // 에러 처리 - updateCartPopupContents 호출하지 않음
        alert(errorData.description || errorData.message || '재고가 부족합니다.');
        
        // 원래 수량으로 복원
        const quantityElement = itemContainer.querySelector('.cart-popup-item-quantity');
        quantityElement.textContent = originalQuantity;
        
        // 실제 장바구니 상태로 새로고침
        return fetch('/cart.js')
          .then(res => res.json())
          .then(realCart => {
            if (realCart && realCart.items) {
              window.updateCartPopupContents(realCart);
            }
          });
      });
    }
  })
  .catch(error => {
    console.error('장바구니 수량 변경 오류:', error);
    
    // 원래 수량으로 복원
    const quantityElement = itemContainer.querySelector('.cart-popup-item-quantity');
    quantityElement.textContent = originalQuantity;
    
    alert('수량 변경 중 오류가 발생했습니다.');
  })
  .finally(() => {
    // UI 상태 복원
    itemContainer.classList.remove('item-updating');
    button.disabled = false;
  });
}

// 장바구니 팝업 내용 업데이트 함수 (에러 객체 처리 개선)
window.updateCartPopupContents = function(cart) {
  console.log('Updating cart popup with:', cart);
  
  // cart 객체 유효성 검사 강화
  if (!cart || typeof cart !== 'object' || cart.status === 422) {
    console.error('Invalid cart object or error response:', cart);
    return;
  }
  
  // 헤더의 장바구니 카운트 업데이트
  const cartCountElements = document.querySelectorAll('.cart-count');
  cartCountElements.forEach(element => {
    if (element) {
      element.textContent = cart.item_count || 0;
    }
  });
  
  const cartPopup = document.getElementById('cart-popup');
  if (!cartPopup) {
    console.error('Cart popup element not found!');
    return;
  }
  
  const cartItems = cartPopup.querySelector('.cart-popup-items');
  const cartTotal = cartPopup.querySelector('.cart-popup-total');
  
  if (!cartItems || !cartTotal) {
    console.error('Cart popup items or total element not found!');
    return;
  }
  
  // 장바구니 아이템 렌더링
  let itemsHTML = '';
  
  if (cart.items && Array.isArray(cart.items) && cart.items.length > 0) {
    cart.items.forEach((item, index) => {
      const imageUrl = item.image 
        ? (typeof item.image === 'string' ? item.image : item.image.src || '')
        : '';
      
      const itemId = item.key || item.id || index + 1;
      
      // variant 옵션 텍스트 생성
      const variantText = formatVariantOptions(item);
      const variantHTML = variantText ? `<div class="cart-popup-item-variant">${variantText}</div>` : '';
      
      itemsHTML += `
        <div class="cart-popup-item" data-item-id="${itemId}" data-item-index="${index + 1}">
          <div class="cart-popup-item-image">
            <img src="${imageUrl.replace(/(\.[^.]*)$/, '_120x$1')}" alt="${item.product_title || item.title}" />
          </div>
          <div class="cart-popup-item-details">
            <div class="i-top">
              <div class="cart-popup-item-title">${item.product_title || item.title}</div>
              ${variantHTML}
              <div class="cart-popup-item-quantity-control">
                <button class="cart-popup-item-quantity-minus" data-item-index="${index + 1}">-</button>
                <span class="cart-popup-item-quantity">${item.quantity}</span>
                <button class="cart-popup-item-quantity-plus" data-item-index="${index + 1}">+</button>
              </div>
            </div>
            <div class="cart-popup-item-price">${window.formatMoney ? window.formatMoney(item.final_price || item.price) : formatMoney(item.final_price || item.price)}</div>
          </div>
          <button class="cart-popup-item-remove" data-item-index="${index + 1}">remove</button>
          <div class="loading-spinner"></div>
        </div>
      `;
    });
  } else {
    itemsHTML = '<div class="cart-popup-empty">empty</div>';
  }
  
  cartItems.innerHTML = itemsHTML;
  
  // 합계 업데이트 (안전한 처리)
  let totalPrice = 0;
  
  if (typeof cart.total_price === 'number') {
    totalPrice = cart.total_price;
  } else if (typeof cart.total_price === 'string') {
    totalPrice = parseInt(cart.total_price) || 0;
  } else if (typeof cart.total === 'number') {
    totalPrice = cart.total;
  } else if (cart.items && Array.isArray(cart.items)) {
    // items에서 직접 계산
    totalPrice = cart.items.reduce((sum, item) => {
      const itemPrice = item.final_line_price || item.line_price || (item.price * item.quantity) || 0;
      return sum + itemPrice;
    }, 0);
  }
  
  cartTotal.textContent = window.formatMoney ? window.formatMoney(totalPrice) : formatMoney(totalPrice);
  
  // 이벤트 리스너 다시 추가
  addCartItemEventListeners(cartItems);
};

// 이벤트 리스너 추가 함수
function addCartItemEventListeners(cartItems) {
  // 삭제 버튼
  const removeButtons = cartItems.querySelectorAll('.cart-popup-item-remove');
  removeButtons.forEach(button => {
    button.addEventListener('click', window.handleRemoveItem);
  });
  
  // 수량 감소 버튼
  const minusButtons = cartItems.querySelectorAll('.cart-popup-item-quantity-minus');
  minusButtons.forEach(button => {
    button.addEventListener('click', window.handleQuantityChange.bind(null, 'decrease'));
  });
  
  // 수량 증가 버튼
  const plusButtons = cartItems.querySelectorAll('.cart-popup-item-quantity-plus');
  plusButtons.forEach(button => {
    button.addEventListener('click', window.handleQuantityChange.bind(null, 'increase'));
  });
}
// 증가 전 재고 확인 함수
function checkInventoryBeforeIncrease(itemIndex, newQuantity, itemContainer, button) {
  // 로딩 상태 표시
  button.disabled = true;
  
  // 현재 장바구니 정보 가져오기
  fetch('/cart.js')
    .then(response => response.json())
    .then(cart => {
      const item = cart.items[itemIndex - 1]; // itemIndex는 1부터 시작
      
      if (!item) {
        throw new Error('아이템을 찾을 수 없습니다.');
      }
      
      // variant ID로 실제 재고 확인
      return checkProductVariantInventory(item.variant_id, newQuantity);
    })
    .then(inventoryInfo => {
      button.disabled = false;
      
      if (inventoryInfo.canPurchase) {
        // 재고가 충분하면 수량 업데이트
        updateCartQuantity(itemIndex, newQuantity, itemContainer, button);
      } else {
        // 재고 부족 시 경고 표시
        alert(`재고가 부족합니다. 최대 구매 가능 수량: ${inventoryInfo.availableQuantity}개`);
      }
    })
    .catch(error => {
      console.error('재고 확인 중 오류:', error);
      button.disabled = false;
      
      // 오류 발생 시 기본 제한으로 폴백
      if (newQuantity > 10) {
        alert('최대 구매 수량은 10개입니다.');
      } else {
        // 오류가 있어도 시도해보기 (서버에서 최종 검증)
        updateCartQuantity(itemIndex, newQuantity, itemContainer, button);
      }
    });
}

// 제품 variant의 실제 재고 확인 함수
async function checkProductVariantInventory(variantId, requestedQuantity) {
  try {
    // Shopify의 variant 정보 API 호출
    const response = await fetch(`/variants/${variantId}.js`);
    
    if (!response.ok) {
      throw new Error('Variant 정보를 가져올 수 없습니다.');
    }
    
    const variant = await response.json();
    
    // 재고 관리 여부 확인
    if (variant.inventory_management !== 'shopify') {
      // 재고 관리를 하지 않는 경우 - 제한 없음
      return {
        canPurchase: true,
        availableQuantity: null
      };
    }
    
    // 재고 정책 확인
    if (variant.inventory_policy === 'continue') {
      // 재고가 없어도 판매 허용하는 경우
      return {
        canPurchase: true,
        availableQuantity: variant.inventory_quantity || 0
      };
    }
    
    // 재고 수량 확인
    const availableQuantity = variant.inventory_quantity || 0;
    
    return {
      canPurchase: requestedQuantity <= availableQuantity,
      availableQuantity: availableQuantity
    };
    
  } catch (error) {
    console.error('Variant 재고 확인 오류:', error);
    
    // API 오류 시 보수적으로 처리
    return {
      canPurchase: false,
      availableQuantity: 0,
      error: error.message
    };
  }
}

// 재고 확인 및 수량 업데이트 함수
function checkInventoryAndUpdateQuantity(itemIndex, newQuantity, itemContainer, button) {
  // 수량 변경 중 UI 상태 표시
  itemContainer.classList.add('item-updating');
  button.disabled = true;
  
  // 현재 장바구니 정보 가져오기
  fetch('/cart.js')
    .then(response => response.json())
    .then(cart => {
      const item = cart.items[itemIndex - 1]; // itemIndex는 1부터 시작
      
      if (!item) {
        throw new Error('아이템을 찾을 수 없습니다.');
      }
      
      // 재고 수량 확인 (여러 방법으로 재고 정보 확인)
      let availableInventory = getAvailableInventory(item);
      
      if (availableInventory !== null && newQuantity > availableInventory) {
        // 재고 부족 알림
        alert(`재고가 부족합니다. 최대 구매 가능 수량: ${availableInventory}개`);
        
        // UI 상태 복원
        itemContainer.classList.remove('item-updating');
        button.disabled = false;
        return;
      }
      
      // 재고가 충분하면 수량 업데이트
      updateCartQuantity(itemIndex, newQuantity, itemContainer, button);
    })
    .catch(error => {
      console.error('재고 확인 중 오류:', error);
      
      // 오류 발생 시 UI 상태 복원
      itemContainer.classList.remove('item-updating');
      button.disabled = false;
      
      // 기본 제한 (10개)으로 폴백
      if (newQuantity > 10) {
        alert('최대 구매 수량은 10개입니다.');
      } else {
        updateCartQuantity(itemIndex, newQuantity, itemContainer, button);
      }
    });
}

// 사용 가능한 재고 수량 확인 함수
function getAvailableInventory(item) {
  // 1. inventory_quantity 직접 확인
  if (typeof item.inventory_quantity === 'number') {
    return item.inventory_quantity;
  }
  
  // 2. variant 정보에서 재고 확인
  if (item.variant && typeof item.variant.inventory_quantity === 'number') {
    return item.variant.inventory_quantity;
  }
  
  // 3. inventory_management가 있는 경우만 재고 제한
  if (item.inventory_management === 'shopify' || item.inventory_management === true) {
    // inventory_policy가 'deny'인 경우 재고 제한 적용
    if (item.inventory_policy === 'deny') {
      // 구체적인 수량 정보가 없으면 Product API를 통해 확인 필요
      return null; // 별도 API 호출 필요
    }
  }
  
  // 4. 재고 관리가 없는 경우 null 반환 (제한 없음)
  return null;
}

// 장바구니 수량 업데이트 함수
function updateCartQuantity(itemIndex, newQuantity, itemContainer, button) {
  // 수량 변경 중 UI 상태 표시
  itemContainer.classList.add('item-updating');
  button.disabled = true;
  
  // 장바구니 업데이트 API 호출
  const body = JSON.stringify({
    line: parseInt(itemIndex),
    quantity: newQuantity
  });
  
  fetch('/cart/change.js', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json'
    },
    body: body
  })
  .then(response => response.json())
  .then(cart => {
    // 장바구니 팝업 업데이트
    window.updateCartPopupContents(cart);
  })
  .catch(error => {
    console.error('장바구니 수량 변경 오류:', error);
    itemContainer.classList.remove('item-updating');
    button.disabled = false;
    
    // 실패 시 원래 수량으로 복원
    const quantityElement = itemContainer.querySelector('.cart-popup-item-quantity');
    quantityElement.textContent = newQuantity - 1; // 원래 수량으로 복원
  });
}

