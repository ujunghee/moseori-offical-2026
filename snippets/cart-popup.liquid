      .then(variant => {
        console.log('Variant info:', variant); // 디버깅용 - 실제 API 응답 확인
        
        button.disabled = false;
        
        // 재고 관리하지 않는 경우 바로 진행
        if (variant.inventory_management !== 'shopify') {
          console.log('재고 관리 안함 - 바로 진행');
