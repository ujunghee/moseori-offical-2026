{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient related-products--full">
  <product-recommendations
    class="related-products section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
  >
    {% if recommendations.performed and recommendations.products_count > 0 %}
      <h2 class="related-products__heading inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
      <div class="related-products__swiper swiper">
        <div class="swiper-wrapper">
          {% for recommendation in recommendations.products %}
            <div class="swiper-slide related-products__slide">
              {% render 'card-product-related', card_product: recommendation %}
            </div>
          {% endfor %}
        </div>
        <div
          class="swiper-button-prev related-products__nav related-products__nav--prev"
          aria-label="{{ 'general.slider.previous_slide' | t }}"
        ></div>
        <div
          class="swiper-button-next related-products__nav related-products__nav--next"
          aria-label="{{ 'general.slider.next_slide' | t }}"
        ></div>
      </div>
    {% endif %}
  </product-recommendations>
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"
/>
<script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js" defer></script>
<script>
/**
 * 관련 상품: Swiper 가로 슬라이드 (드래그·화살표).
 */
(function () {
  const SELECTOR = '.related-products__swiper';

  function initInRoot(root) {
    if (typeof Swiper === 'undefined') return;

    root.querySelectorAll(SELECTOR).forEach((el) => {
      if (el.swiper) return;
      if (!el.querySelector('.swiper-slide')) return;

      const prev = el.querySelector('.swiper-button-prev');
      const next = el.querySelector('.swiper-button-next');

      new Swiper(el, {
        slidesPerView: 'auto',
        spaceBetween: 24,
        grabCursor: true,
        watchOverflow: true,
        navigation:
          prev && next
            ? {
                prevEl: prev,
                nextEl: next,
              }
            : undefined,
      });
    });
  }

  function run() {
    document.querySelectorAll('product-recommendations').forEach(initInRoot);
  }

  function runWhenSwiperReady() {
    if (typeof Swiper !== 'undefined') {
      run();
      return;
    }
    let n = 0;
    const id = setInterval(() => {
      if (typeof Swiper !== 'undefined' || ++n > 100) {
        clearInterval(id);
        if (typeof Swiper !== 'undefined') run();
      }
    }, 30);
  }

  const mo = new MutationObserver(runWhenSwiperReady);
  document.querySelectorAll('product-recommendations').forEach((el) => {
    mo.observe(el, { childList: true, subtree: true });
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runWhenSwiperReady);
  } else {
    runWhenSwiperReady();
  }
})();

</script>

{% schema %}
{
  "name": "t:sections.related-products.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
